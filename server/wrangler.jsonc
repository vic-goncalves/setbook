{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setbook",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setbook",
      // Created with `npx wrangler d1 create setbook`. Use your own id if you fork this.
      "database_id": "8a8ae88a-5671-4c74-b3b7-e364985c14ca",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public origin of this Worker, e.g. https://setbook.<you>.workers.dev. Google sends
    // users back to <APP_ORIGIN>/v1/auth/google/callback.
    "APP_ORIGIN": "https://setbook.vic-goncalves.workers.dev",
    "GOOGLE_CLIENT_ID": "143983451282-unagecl8dbqeev9l6o2g6niee1j8ovcc.apps.googleusercontent.com",
    // Only "true" in local development. Enables POST /v1/auth/dev, which signs in without Google.
    "DEV_AUTH": "false",
    // Browser origins allowed to call the API and receive sign-in redirects. Local
    // development adds http://localhost:5173 through .dev.vars.
    "WEB_ORIGINS": "https://vic-goncalves.github.io",
    // Model for the in-app coach (POST /v1/chat).
    "CHAT_MODEL": "claude-sonnet-5-5"
  }
  // Secrets (never in this file): GOOGLE_CLIENT_SECRET, SESSION_SIGNING_KEY, ANTHROPIC_API_KEY.
  // Set with `npx wrangler secret put <NAME>`; locally they live in .dev.vars.
}
